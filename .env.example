# Copy to .env and fill in the real value. Never commit .env.
# .env is already git-ignored.
#
#   cp .env.example .env        # Windows: copy .env.example .env
#
# There is no valid value to commit here on purpose. A file that ships with a
# working key is a leaked key.

# --- Required ---------------------------------------------------------------

# The only secret in this project. Get a free-tier key at
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Groq model -------------------------------------------------------------

# Any chat model available on your Groq tier. Loaded as config.CONFIG.llm_model.
# Verified available at build time: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b, canopylabs/orpheus-v1-english.
# NOTE: llama-3.3-70b-versatile is RETIRED and returns 404. Check yours with:
#   python -c "import config; from groq import Groq; \
#   print([m.id for m in Groq(api_key=config.CONFIG.groq_api_key).models.list().data])"
# Run `python -c "import config; print(config.CONFIG.llm_model)"` to confirm.
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional overrides (defaults shown) ------------------------------------

# Local embedding model. No API key, 384-dim. Must match the model used at
# ingest time or the query vector will not share the corpus vector space.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
# TOP_K=8
# SCORE_THRESHOLD=0.65
# MAX_TOKENS=220
# TEMPERATURE=0.0

# Chunking (Phase 2 calibrated these against the corpus)
# CHUNK_SIZE=450
# CHUNK_OVERLAP=60
