# Copy to .env and fill in the real value. Never commit .env.
# .env is already git-ignored.
#
#   cp .env.example .env        # Windows: copy .env.example .env
#
# There is no valid value to commit here on purpose. A file that ships with a
# working key is a leaked key.

# --- Required ---------------------------------------------------------------

# The only secret in this project. Get a free-tier key at
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Groq model -------------------------------------------------------------

# Any chat model available on your Groq tier. Loaded as config.CONFIG.llm_model.
# Verified available at build time: qwen/qwen3.8-27b, openai/gpt-oss-120b,
# openai/gpt-oss-20b, canopylabs/orpheus-v1-english.
# NOTE: llama-3.3-70b-versatile is RETIRED and returns 404. Check yours with:
#   python -c "import config; from groq import Groq; \
#   print([m.id for m in Groq(api_key=config.CONFIG.groq_api_key).models.list().data])"
# Run `python -c "import config; print(config.CONFIG.llm_model)"` to confirm.
#
# The default is qwen/qwen3.8-27b because it is the fastest option that still
# follows the answer contract. It emits no chain-of-thought, so the whole
# response budget goes to the visible answer. Measured over the eight in-scope
# questions: 0.44-0.66s per turn, against 1.45-1.83s for openai/gpt-oss-120b,
# which spends 1257-1641 characters of hidden reasoning on a 3-sentence answer.
GROQ_MODEL=qwen/qwen3.8-27b

# Only for the reasoning models (gpt-oss-*). "low" cut the 120b model's
# latency roughly in half. Leave unset for non-reasoning models - they reject
# the field, and an unknown parameter is a 400.
# GROQ_MODEL_REASONING_EFFORT=low

# --- Optional overrides (defaults shown) ------------------------------------

# ONNX export of all-MiniLM-L6-v2. Produces vectors identical to the
# sentence-transformers weights, so an existing data/chroma store stays valid.
# The ~87MB download is cached under MODEL_CACHE_DIR and is pre-fetched during
# the deploy build, so it never blocks a user's first question.
# EMBEDDING_MODEL=optimum/all-MiniLM-L6-v2
# MODEL_CACHE_DIR=data/models

# Retrieval
# TOP_K=8
# SCORE_THRESHOLD=0.65
# MAX_TOKENS=400
# TEMPERATURE=0.0

# How many retrieved blocks go into the PROMPT. 0 means "all of TOP_K", which is
# the default and the safe one. This is a throughput lever, not a free one: the
# free Groq tier allows 7,000 input tokens/minute and a question costs ~1,500 of
# them, so the ceiling is about 4 questions a minute. Setting 6 measured the same
# answers for ~200 fewer tokens; setting 5 or 4 lost a benchmark question
# outright. Leave it unset unless you have measured your own questions.
# LLM_CONTEXT_K=0

# Chunking (Phase 2 calibrated these against the corpus)
# CHUNK_SIZE=450
# CHUNK_OVERLAP=60
